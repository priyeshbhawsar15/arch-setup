# Managed by arch-setups: automatic ambilight profile (install-hyperhdr.sh).
[Unit]
Description=Ambilight auto profile (movie/game/work) for HyperHDR
PartOf=graphical-session.target
After=graphical-session.target hyperhdr.service
Wants=hyperhdr.service

[Service]
Type=simple
ExecStart=%h/.local/bin/ambilight watch
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
