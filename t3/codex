#!/bin/bash
# Runtime resolution is read-only. Install/update explicitly with install-codex.sh.
executable="$(mise which codex)" || { printf 'codex: mise backend missing; rerun install-codex.sh.\n' >&2; exit 1; }
if [[ "$executable" != /* || ! -x "$executable" || "$executable" -ef "${BASH_SOURCE[0]}" ]]; then
  printf 'codex: mise did not resolve a usable backend executable (wrapper recursion refused).\n' >&2
  exit 1
fi
exec "$executable" "$@"
