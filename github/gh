#!/bin/bash
# Runtime resolution is read-only. Install/update explicitly with install-github-cli.sh.
executable="$(mise which gh)" || { printf 'gh: mise backend missing; rerun install-github-cli.sh.\n' >&2; exit 1; }
if [[ "$executable" != /* || ! -x "$executable" || "$executable" -ef "${BASH_SOURCE[0]}" ]]; then
  printf 'gh: mise did not resolve a usable backend executable (wrapper recursion refused).\n' >&2
  exit 1
fi
exec "$executable" "$@"
